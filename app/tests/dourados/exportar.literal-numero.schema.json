{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registro",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "tipo": {
          "const": "evento"
        },
        "id": {
          "type": "integer"
        },
        "moeda": {
          "const": "BRL"
        },
        "msg": {
          "type": "string"
        },
        "nivel": {
          "type": "string"
        },
        "duracao": {
          "type": "number"
        }
      },
      "required": ["tipo", "id", "moeda", "msg", "nivel", "duracao"]
    },
    {
      "type": "object",
      "properties": {
        "tipo": {
          "const": "pagamento"
        },
        "id": {
          "type": "integer"
        },
        "moeda": {
          "const": "BRL"
        },
        "valor": {
          "type": "number"
        },
        "parcelas": {
          "const": 3
        },
        "aprovado": {
          "type": "boolean"
        },
        "protocolo": {
          "type": "integer"
        }
      },
      "required": ["tipo", "id", "moeda", "valor", "parcelas", "aprovado", "protocolo"]
    },
    {
      "type": "object",
      "properties": {
        "tipo": {
          "const": "pedido"
        },
        "id": {
          "type": "integer"
        },
        "moeda": {
          "const": "BRL"
        },
        "cliente": {
          "type": "object",
          "properties": {
            "nome": {
              "type": "string"
            },
            "cidade": {
              "anyOf": [
                {
                  "const": "Cidade Fict\u00edcia"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["nome", "cidade"]
        },
        "itens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sku": {
                "type": "string"
              },
              "qtd": {
                "type": "integer"
              },
              "preco": {
                "type": "number"
              }
            },
            "required": ["sku", "qtd", "preco"]
          }
        },
        "cupom": {
          "type": "null"
        },
        "obs": {
          "const": "entregar \u00e0 tarde"
        }
      },
      "required": ["tipo", "id", "moeda", "cliente", "itens", "cupom"]
    }
  ]
}
