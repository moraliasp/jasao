{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jasão",
  "identifier": "br.com.moralia.jasao",
  "version": "0.0.1",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Moralia",
    "targets": "all",
    "category": "DeveloperTool",
    "fileAssociations": [
      {
        "ext": ["json"],
        "contentTypes": ["public.json"],
        "name": "JSON",
        "description": "JSON",
        "mimeType": "application/json",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["jsonl", "ndjson"],
        "name": "JSON Lines",
        "description": "JSON Lines",
        "mimeType": "application/x-ndjson",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
